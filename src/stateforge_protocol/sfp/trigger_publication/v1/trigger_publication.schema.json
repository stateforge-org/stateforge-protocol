{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateforge:sfp:trigger_publication:1",
  "title": "SFP trigger-publication schema 1 ProtoJSON validation",
  "description": "Validate complete trigger-stream ProtoJSON projections with lowerCamelCase field names and non-presence defaults emitted. The schema enforces structural bounds. Stream sequencing, active session and manifest checks, payload validation against the selected manifest trigger schema, canonical publication equality, durable acceptance, flow control, and acknowledgement correlation remain consumer/runtime checks described by the procedure and covered by conformance tests.",
  "$ref": "#/$defs/triggerStreamResponse",
  "$defs": {
    "uuid4": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]*(?![\\s\\S])"
    },
    "versionedIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+/[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@[1-9][0-9]*(?![\\s\\S])"
    },
    "revision": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "positiveDuration": {
      "type": "string",
      "minLength": 2,
      "maxLength": 22,
      "pattern": "^(0\\.(?=[0-9]*[1-9])[0-9]{1,9}|[1-9][0-9]*(\\.[0-9]{1,9})?)s(?![\\s\\S])"
    },
    "receiveWindow": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "boundedScalar": {
      "description": "A scalar payload value. String length is measured in Unicode code points.",
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string", "maxLength": 65536}
      ]
    },
    "boundedArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/boundedValue"},
      "maxItems": 256
    },
    "boundedObject": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {"maxLength": 128},
      "additionalProperties": {"$ref": "#/$defs/boundedValue"}
    },
    "boundedValue": {
      "description": "A recursively nested JSON value. Aggregate nesting depth and serialized message size are enforced outside JSON Schema.",
      "anyOf": [
        {"$ref": "#/$defs/boundedScalar"},
        {"$ref": "#/$defs/boundedArray"},
        {"$ref": "#/$defs/boundedObject"}
      ]
    },
    "acknowledgementDisposition": {
      "enum": [
        "TRIGGER_ACKNOWLEDGEMENT_DISPOSITION_ACCEPTED_NEW",
        "TRIGGER_ACKNOWLEDGEMENT_DISPOSITION_ACCEPTED_DUPLICATE",
        "TRIGGER_ACKNOWLEDGEMENT_DISPOSITION_REJECTED"
      ]
    },
    "rejectionReason": {
      "enum": [
        "TRIGGER_REJECTION_REASON_INVALID_PUBLICATION",
        "TRIGGER_REJECTION_REASON_TRIGGER_NOT_DECLARED",
        "TRIGGER_REJECTION_REASON_PAYLOAD_SCHEMA_VIOLATION",
        "TRIGGER_REJECTION_REASON_IDEMPOTENCY_CONFLICT",
        "TRIGGER_REJECTION_REASON_AGENT_CAPACITY_EXHAUSTED",
        "TRIGGER_REJECTION_REASON_DELIVERY_RESPONSIBILITY_UNAVAILABLE"
      ]
    },
    "triggerSessionBinding": {
      "type": "object",
      "properties": {
        "expectedProviderInstanceId": {"$ref": "#/$defs/uuid4"},
        "expectedEndpointGeneration": {"$ref": "#/$defs/generation"},
        "expectedSessionId": {"$ref": "#/$defs/sessionId"},
        "expectedManifestRevision": {"$ref": "#/$defs/revision"}
      },
      "required": [
        "expectedProviderInstanceId",
        "expectedEndpointGeneration",
        "expectedSessionId",
        "expectedManifestRevision"
      ],
      "additionalProperties": false
    },
    "triggerStreamOpen": {
      "type": "object",
      "properties": {
        "sessionBinding": {"$ref": "#/$defs/triggerSessionBinding"},
        "requestedMaxInFlightPublications": {"$ref": "#/$defs/receiveWindow"}
      },
      "required": [
        "sessionBinding",
        "requestedMaxInFlightPublications"
      ],
      "additionalProperties": false
    },
    "triggerStreamReady": {
      "type": "object",
      "properties": {
        "providerInstanceId": {"$ref": "#/$defs/uuid4"},
        "endpointGeneration": {"$ref": "#/$defs/generation"},
        "sessionId": {"$ref": "#/$defs/sessionId"},
        "manifestRevision": {"$ref": "#/$defs/revision"},
        "maximumInFlightPublications": {"$ref": "#/$defs/receiveWindow"}
      },
      "required": [
        "providerInstanceId",
        "endpointGeneration",
        "sessionId",
        "manifestRevision",
        "maximumInFlightPublications"
      ],
      "additionalProperties": false
    },
    "triggerPublication": {
      "type": "object",
      "properties": {
        "publicationId": {"$ref": "#/$defs/uuid4"},
        "triggerIdentifier": {"$ref": "#/$defs/versionedIdentifier"},
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "payload": {"$ref": "#/$defs/boundedObject"}
      },
      "required": [
        "publicationId",
        "triggerIdentifier",
        "observedAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "triggerRejection": {
      "type": "object",
      "properties": {
        "reason": {"$ref": "#/$defs/rejectionReason"},
        "retryable": {"type": "boolean"},
        "retryAfter": {"$ref": "#/$defs/positiveDuration"},
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["reason", "retryable", "explanation"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["retryAfter"]},
          "then": {"properties": {"retryable": {"const": true}}}
        }
      ]
    },
    "triggerAcknowledgement": {
      "type": "object",
      "properties": {
        "publicationId": {"$ref": "#/$defs/uuid4"},
        "disposition": {"$ref": "#/$defs/acknowledgementDisposition"},
        "rejection": {"$ref": "#/$defs/triggerRejection"}
      },
      "required": ["publicationId", "disposition"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "TRIGGER_ACKNOWLEDGEMENT_DISPOSITION_REJECTED"
              }
            },
            "required": ["disposition"]
          },
          "then": {"required": ["rejection"]},
          "else": {"not": {"required": ["rejection"]}}
        }
      ]
    },
    "triggerStreamRequest": {
      "type": "object",
      "properties": {
        "open": {"$ref": "#/$defs/triggerStreamOpen"},
        "acknowledgement": {"$ref": "#/$defs/triggerAcknowledgement"}
      },
      "oneOf": [
        {"required": ["open"]},
        {"required": ["acknowledgement"]}
      ],
      "additionalProperties": false
    },
    "triggerStreamResponse": {
      "type": "object",
      "properties": {
        "ready": {"$ref": "#/$defs/triggerStreamReady"},
        "publication": {"$ref": "#/$defs/triggerPublication"}
      },
      "oneOf": [
        {"required": ["ready"]},
        {"required": ["publication"]}
      ],
      "additionalProperties": false
    }
  }
}
