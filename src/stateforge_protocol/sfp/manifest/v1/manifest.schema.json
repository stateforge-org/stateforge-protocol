{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateforge:sfp:manifest:1",
  "title": "SFP manifest schema 1 ProtoJSON validation",
  "description": "Validate ProtoJSON using lowerCamelCase field names and all non-presence defaults emitted. This schema validates structure; session binding, negotiation, revision integrity, JSON reference resolution and semantic compliance require consumer checks described in the procedure specification.",
  "$ref": "#/$defs/getManifestResponse",
  "$defs": {
    "instanceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]*(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+/[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@[1-9][0-9]*(?![\\s\\S])"
    },
    "dottedIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+(?![\\s\\S])"
    },
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "revision": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "schemaDocument": {
      "allOf": [
        {
          "$ref": "https://json-schema.org/draft/2020-12/schema"
        },
        {
          "$ref": "#/$defs/schemaRules"
        }
      ],
      "type": "object",
      "required": [
        "$schema",
        "type"
      ],
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "type": {
          "const": "object"
        }
      }
    },
    "schemaRules": {
      "description": "Additional schema-only restrictions: local references and no defaults, examples, const or enum on writeOnly fields. Semantic secret detection remains the runtime author responsibility.",
      "type": [
        "object",
        "boolean"
      ],
      "if": {
        "type": "object",
        "required": [
          "writeOnly"
        ],
        "properties": {
          "writeOnly": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "default"
              ]
            },
            {
              "required": [
                "examples"
              ]
            },
            {
              "required": [
                "const"
              ]
            },
            {
              "required": [
                "enum"
              ]
            }
          ]
        }
      },
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#"
        },
        "$dynamicRef": {
          "type": "string",
          "pattern": "^#"
        },
        "$id": false,
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/schemaRules"
          }
        },
        "patternProperties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/schemaRules"
          }
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/schemaRules"
          }
        },
        "dependentSchemas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/schemaRules"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/schemaRules"
        },
        "unevaluatedProperties": {
          "$ref": "#/$defs/schemaRules"
        },
        "propertyNames": {
          "$ref": "#/$defs/schemaRules"
        },
        "items": {
          "$ref": "#/$defs/schemaRules"
        },
        "unevaluatedItems": {
          "$ref": "#/$defs/schemaRules"
        },
        "contains": {
          "$ref": "#/$defs/schemaRules"
        },
        "not": {
          "$ref": "#/$defs/schemaRules"
        },
        "if": {
          "$ref": "#/$defs/schemaRules"
        },
        "then": {
          "$ref": "#/$defs/schemaRules"
        },
        "else": {
          "$ref": "#/$defs/schemaRules"
        },
        "contentSchema": {
          "$ref": "#/$defs/schemaRules"
        },
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaRules"
          }
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaRules"
          }
        },
        "oneOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaRules"
          }
        },
        "prefixItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaRules"
          }
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/schemaRules"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "properties": {
        "inputSchema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "resultSchema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "implements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dottedIdentifier"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "inputSchema",
        "resultSchema",
        "implements"
      ],
      "additionalProperties": false
    },
    "runtimeRequirement": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "versionConstraint": {
          "type": "string",
          "minItems": 0,
          "maxLength": 255
        }
      },
      "required": [
        "description",
        "versionConstraint"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "operatingSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
        }
      },
      "required": [
        "operatingSystem",
        "architecture"
      ],
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "properties": {
        "payloadSchema": {
          "$ref": "#/$defs/schemaDocument"
        }
      },
      "required": [
        "payloadSchema"
      ],
      "additionalProperties": false
    },
    "jsonPointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(/([^~/]|~0|~1)*)+$(?![\\s\\S])"
    },
    "bindingPointer": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/jsonPointer"
        }
      ]
    },
    "presentationScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
    },
    "dataBinding": {
      "type": "object",
      "properties": {
        "sourceIdentifier": {
          "$ref": "#/$defs/identifier"
        },
        "pointer": {
          "$ref": "#/$defs/bindingPointer"
        },
        "scope": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/presentationScope"
            }
          ]
        }
      },
      "required": [
        "sourceIdentifier",
        "pointer",
        "scope"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/dataBinding"
        },
        "operator": {
          "enum": [
            "CONDITION_OPERATOR_EXISTS",
            "CONDITION_OPERATOR_NOT_EXISTS",
            "CONDITION_OPERATOR_EQUALS",
            "CONDITION_OPERATOR_NOT_EQUALS"
          ]
        },
        "value": true
      },
      "required": [
        "binding",
        "operator"
      ],
      "additionalProperties": false
    },
    "repetition": {
      "type": "object",
      "properties": {
        "collection": {
          "$ref": "#/$defs/dataBinding"
        },
        "itemScope": {
          "$ref": "#/$defs/presentationScope"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "required": [
        "collection",
        "itemScope",
        "maxItems"
      ],
      "additionalProperties": false
    },
    "componentNode": {
      "type": "object",
      "properties": {
        "componentIdentifier": {
          "$ref": "#/$defs/identifier"
        },
        "properties": {
          "type": "object"
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/presentationScope"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dataBinding"
          },
          "minProperties": 0,
          "maxProperties": 64
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentNode"
          },
          "minLength": 0,
          "maxItems": 256
        },
        "fallback": {
          "$ref": "#/$defs/componentNode"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "repeat": {
          "$ref": "#/$defs/repetition"
        },
        "assetBindings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/presentationScope"
          },
          "additionalProperties": {
            "$ref": "#/$defs/revision"
          },
          "minProperties": 0,
          "maxProperties": 32
        }
      },
      "required": [
        "componentIdentifier",
        "properties",
        "bindings",
        "children",
        "assetBindings"
      ],
      "additionalProperties": false
    },
    "presentationSurface": {
      "type": "object",
      "properties": {
        "root": {
          "$ref": "#/$defs/componentNode"
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "presentationTarget": {
      "type": "object",
      "properties": {
        "surfaces": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/presentationSurface"
          },
          "minProperties": 1,
          "maxProperties": 8
        }
      },
      "required": [
        "surfaces"
      ],
      "additionalProperties": false
    },
    "rendererRequirement": {
      "type": "object",
      "properties": {
        "extensionIdentifier": {
          "$ref": "#/$defs/identifier"
        },
        "extensionVersion": {
          "$ref": "#/$defs/semver"
        },
        "rendererApiVersion": {
          "$ref": "#/$defs/semver"
        },
        "artifactDigest": {
          "$ref": "#/$defs/revision"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "extensionIdentifier",
        "extensionVersion",
        "rendererApiVersion",
        "artifactDigest",
        "permissions"
      ],
      "additionalProperties": false
    },
    "presentationAsset": {
      "type": "object",
      "properties": {
        "mediaType": {
          "enum": [
            "image/png",
            "image/svg+xml"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "altText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "mediaType",
        "content",
        "width",
        "height",
        "altText"
      ],
      "additionalProperties": false
    },
    "providerPresentation": {
      "type": "object",
      "properties": {
        "presentationSchemaVersion": {
          "const": 1
        },
        "provider": {
          "$ref": "#/$defs/presentationTarget"
        },
        "operations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/presentationTarget"
          },
          "minProperties": 0,
          "maxProperties": 1024
        },
        "triggers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/presentationTarget"
          },
          "minProperties": 0,
          "maxProperties": 1024
        },
        "assets": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/revision"
          },
          "additionalProperties": {
            "$ref": "#/$defs/presentationAsset"
          },
          "minProperties": 0,
          "maxProperties": 64
        },
        "rendererRequirements": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/dottedIdentifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/rendererRequirement"
          },
          "minProperties": 0,
          "maxProperties": 64
        }
      },
      "required": [
        "presentationSchemaVersion",
        "operations",
        "triggers",
        "assets",
        "rendererRequirements"
      ],
      "additionalProperties": false
    },
    "providerManifest": {
      "type": "object",
      "properties": {
        "providerIdentity": {
          "$ref": "#/$defs/dottedIdentifier"
        },
        "implementationVersion": {
          "$ref": "#/$defs/semver"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "operations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          },
          "minProperties": 0,
          "maxProperties": 1024
        },
        "runtimeRequirements": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/dottedIdentifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/runtimeRequirement"
          },
          "minProperties": 0,
          "maxProperties": 1024
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platform"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "configurationSchema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "triggers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/trigger"
          },
          "minProperties": 0,
          "maxProperties": 1024
        }
      },
      "required": [
        "providerIdentity",
        "implementationVersion",
        "displayName",
        "operations",
        "runtimeRequirements",
        "platforms",
        "configurationSchema",
        "triggers"
      ],
      "additionalProperties": false
    },
    "getManifestRequest": {
      "type": "object",
      "properties": {
        "expectedProviderInstanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "expectedEndpointGeneration": {
          "$ref": "#/$defs/generation"
        },
        "supportedManifestSchemaVersions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "expectedSessionId": {
          "$ref": "#/$defs/sessionId"
        }
      },
      "required": [
        "expectedProviderInstanceId",
        "expectedEndpointGeneration",
        "supportedManifestSchemaVersions",
        "expectedSessionId"
      ],
      "additionalProperties": false
    },
    "getManifestResponse": {
      "type": "object",
      "properties": {
        "providerInstanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "endpointGeneration": {
          "$ref": "#/$defs/generation"
        },
        "manifestSchemaVersion": {
          "const": 1
        },
        "manifestRevision": {
          "$ref": "#/$defs/revision"
        },
        "manifest": {
          "$ref": "#/$defs/providerManifest"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "presentation": {
          "type": "object",
          "required": [
            "presentationSchemaVersion"
          ],
          "properties": {
            "presentationSchemaVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "additionalProperties": true
        },
        "presentationRevision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "providerInstanceId",
        "endpointGeneration",
        "manifestSchemaVersion",
        "manifestRevision",
        "manifest",
      "sessionId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "presentation"
            ]
          },
          "then": {
        "required": [
          "presentationRevision"
        ],
            "properties": {
              "presentationRevision": {
                "$ref": "#/$defs/revision"
              }
            }
          },
        "else": {
          "not": {
            "required": [
              "presentationRevision"
            ]
            }
          }
        }
      ]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    }
  }
}
