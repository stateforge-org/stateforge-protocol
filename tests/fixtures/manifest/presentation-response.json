  "presentation": {
    "presentationSchemaVersion": 1,
    "provider": {
      "summary": "Inspect and resolve Git references.",
      "description": "A local Provider for Git repository state.",
      "iconAssetDigest": "sha256:8c5dec37f2aba701bd79272fc7fe4d34292623e531df7fd23b95cb3c96034741",
      "bannerAssetDigest": "",
      "groups": [
        {
          "id": "repository",
          "label": "Repository",
          "description": "Repository inspection and reference operations.",
          "iconAssetDigest": ""
        }
      ]
    },
    "operations": {
      "stateforge.git/reference.resolve@1": {
        "label": "Resolve reference",
        "summary": "Resolve a Git reference to a commit.",
        "description": "Reads a repository reference without changing it.",
        "iconAssetDigest": "",
        "groupId": "repository",
        "input": {
          "fieldOrder": [
            "/properties/repository",
            "/properties/depth",
            "/properties/token"
          ],
          "groups": [
            {
              "id": "credentials",
              "label": "Credentials",
              "description": "Optional credentials for repository access.",
              "fields": [
                "/properties/token"
              ]
            }
          ],
          "fields": {
            "/properties/repository": {
              "label": "Repository",
              "helpText": "Repository path or canonical name.",
              "placeholder": "owner/repository",
              "unit": "",
              "widget": "INPUT_WIDGET_TEXT",
              "display": "DISPLAY_STYLE_UNSPECIFIED"
            },
            "/properties/depth": {
              "label": "Depth",
              "helpText": "Maximum history depth.",
              "placeholder": "",
              "unit": "commits",
              "widget": "INPUT_WIDGET_SLIDER",
              "display": "DISPLAY_STYLE_METRIC"
            },
            "/properties/token": {
              "label": "Access token",
              "helpText": "Used only for this request.",
              "placeholder": "",
              "unit": "",
              "widget": "INPUT_WIDGET_SECRET",
              "display": "DISPLAY_STYLE_UNSPECIFIED"
            }
          }
        },
        "result": {
          "fieldOrder": [
            "/properties/commit",
            "/properties/changed"
          ],
          "groups": [],
          "fields": {
            "/properties/commit": {
              "label": "Commit",
              "helpText": "Resolved commit identifier.",
              "placeholder": "",
              "unit": "",
              "widget": "INPUT_WIDGET_UNSPECIFIED",
              "display": "DISPLAY_STYLE_CODE"
            },
            "/properties/changed": {
              "label": "Changed",
              "helpText": "Whether the reference changed.",
              "placeholder": "",
              "unit": "",
              "widget": "INPUT_WIDGET_UNSPECIFIED",
              "display": "DISPLAY_STYLE_BADGE"
            }
          }
        }
      }
    },
    "triggers": {
      "stateforge.git/reference.changed@1": {
        "label": "Reference changed",
        "summary": "A repository reference moved.",
        "description": "Published after a tracked reference changes.",
        "iconAssetDigest": "",
        "groupId": "repository",
        "payload": {
          "fieldOrder": [
            "/properties/reference",
            "/properties/previous"
          ],
          "groups": [],
          "fields": {
            "/properties/reference": {
              "label": "Reference",
              "helpText": "Current reference value.",
              "placeholder": "",
              "unit": "",
              "widget": "INPUT_WIDGET_UNSPECIFIED",
              "display": "DISPLAY_STYLE_CODE"
            },
            "/properties/previous": {
              "label": "Previous",
              "helpText": "Previous reference value.",
              "placeholder": "",
              "unit": "",
              "widget": "INPUT_WIDGET_UNSPECIFIED",
              "display": "DISPLAY_STYLE_CODE"
            }
          }
        }
      }
    },
