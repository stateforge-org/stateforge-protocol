{
  "triggerIdentifier": "stateforge.git/reference.changed@1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repository": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "commitSha": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "required": [
      "repository",
      "ref",
      "commitSha"
    ],
    "additionalProperties": false
  }
}
